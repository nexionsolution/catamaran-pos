{
  "name": "catamaran-pos",
  "version": "1.0.2",
  "description": "Catamaran Surf Club & Restaurant POS Terminal - Web Application",
  "main": "backend/server.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "server": "node backend/server.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "start": "node backend/server.js",
    "typecheck": "npm run typecheck --prefix frontend",
    "lint": "eslint frontend/",
    "format": "prettier --write ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "mongoose": "^9.11.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.14.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.2.6"
  }
}
